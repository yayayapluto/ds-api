# Contoh isi berkas .env untuk daspro-api.
# Salin berkas ini jadi .env, lalu isi nilainya.
#
#     cp .env.example .env
#
# Berkas .env asli tidak ikut masuk git (lihat .gitignore), jadi kunci API
# tidak akan pernah terunggah.

# --- layanan AI -----------------------------------------------------------
# Kunci rahasia dari penyedia. Jangan dibagikan ke siapa pun.
DASPRO_AI_API_KEY=

# Alamat layanan. Ganti kalau memakai penyedia lain yang antarmukanya sama.
# Contoh: https://openrouter.ai/api/v1 atau http://localhost:11434/v1
DASPRO_AI_BASE_URL=https://api.openai.com/v1

# Nama model yang dipakai.
DASPRO_AI_MODEL=gpt-4o-mini

# auto  : pakai layanan di atas
# mock  : jawaban tiruan, untuk uji coba tanpa internet dan tanpa kunci
DASPRO_AI_PROVIDER=auto

# Batas waktu satu panggilan ke layanan AI, dalam detik.
DASPRO_AI_TIMEOUT=180

# Batas panjang jawaban AI.
DASPRO_AI_MAX_TOKENS=8192

# --- server ---------------------------------------------------------------
DASPRO_HOST=127.0.0.1
DASPRO_PORT=8787

# Kalau diisi, setiap permintaan wajib menyertakan header
# Authorization: Bearer <token>
DASPRO_AUTH_TOKEN=

# --- berkas kerja ---------------------------------------------------------
# Tempat menyimpan berkas sementara dan hasil pekerjaan.
# DASPRO_DATA_DIR=./data

# Folder skill solve-daspro. Kalau dikosongkan, dipakai salinan di ./skill.
# DASPRO_SKILL_DIR=./skill

# Batas ukuran berkas yang boleh diunggah, dalam MB.
DASPRO_MAX_UPLOAD_MB=32

# --- kompilasi dan pengujian ---------------------------------------------
# Program kompilator yang dipakai.
DASPRO_GCC=gcc

# Batas waktu menjalankan satu program C, dalam detik.
DASPRO_RUN_TIMEOUT=5

# Batas memori satu program C, dalam MB.
DASPRO_MEMORY_MB=256

# Berapa kali kode dikirim balik ke AI kalau gagal dikompilasi.
DASPRO_MAX_REPAIR=2

# --- pekerjaan latar belakang --------------------------------------------
# Berapa pekerjaan yang boleh berjalan bersamaan.
DASPRO_JOB_WORKERS=2

# Umur hasil pekerjaan sebelum dihapus, dalam jam.
DASPRO_JOB_TTL_JAM=24
